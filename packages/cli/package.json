{
  "name": "@kitecd/cli",
  "version": "1.4.0",
  "type": "module",
  "bin": {
    "kite": "./bin/kite.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/web && mkdir -p dist/web && cp -R ../../apps/web/dist/. dist/web/",
    "dev": "tsc -w",
    "postinstall": "node scripts/postinstall.js",
    "release": "bumpp package.json ../../apps/web/package.json ../../apps/server/package.json --execute='sh -c \"changelogen --output ../../CHANGELOG.md && git add ../../CHANGELOG.md && cd ../.. && bun run build\"' --tag --push"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "busboy": "^1.6.0",
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "form-data": "^4.0.0",
    "node-pty": "^1.1.0",
    "ora": "^8.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "bumpp": "^11.1.0",
    "changelogen": "^0.6.2",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.2",
    "@types/busboy": "^1.5.4"
  }
}
